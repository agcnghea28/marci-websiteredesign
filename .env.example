# Contact form is demo-only (no email sent). The settings below are unused unless
# you wire sendContactEmail back into app/api/contact/route.js.

# Contact form — optional real email (pick ONE provider)

# Option A: Resend (https://resend.com) — verify a domain to email any address.
# With onboarding@resend.dev you can only send to your Resend account email.
RESEND_API_KEY=
CONTACT_FROM_EMAIL="Marci Metzger <onboarding@resend.dev>"

# Option B: Gmail / SMTP (good for quick testing to any inbox)
# Use a Google App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Optional when using SMTP only; defaults to SMTP_USER display name
# CONTACT_FROM_EMAIL="Marci Metzger <you@gmail.com>"
